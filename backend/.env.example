# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local: mongodb://127.0.0.1:27017/travelmate, or a free MongoDB Atlas cluster URI)
MONGODB_URI=mongodb://127.0.0.1:27017/travelmate

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL (for CORS + OAuth redirect back to the app)
CLIENT_URL=http://localhost:5173

# Seed script — password used for the 5 test user accounts + admin (plain text
# here only, it is hashed before being stored in MongoDB). These accounts are
# never shown in the frontend; they exist only so 5 real accounts can be
# tested, per the course requirement.
SEED_PASSWORD=TravelMate@123

# Email ticket delivery (Nodemailer/SMTP) — e.g. Gmail SMTP with an App Password,
# or Mailtrap for safe testing. Leave blank to disable email sending; ticket
# download and the rest of the app keep working either way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TravelMate <no-reply@travelmate.app>

# Optional — if set, the backend can validate attraction data against Google
# Places. If left blank, the app uses its own curated/verified attraction
# database (server/seeds/data/attractions.js) and keeps working normally.
GOOGLE_PLACES_API_KEY=
